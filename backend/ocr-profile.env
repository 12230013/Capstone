# new_ocr model profile; shared database/storage/session settings remain in .env.
OCR_ENGINE=paddleocr_vl
OCR_MODEL_ID=PaddleOCR-VL-1.6
PADDLE_DEVICE=cpu
# Layout stays on CPU; recognition is served locally on the M5 Metal GPU.
PADDLE_VL_BACKEND=mlx-vlm-server
PADDLE_VL_SERVER_URL=http://127.0.0.1:8111/
