MONGO_URI = 
CDR_API_BASE_URL=http://localhost:5000
CDR_API_TIMEOUT=15

RELATIONSHIP_API=http://localhost:3000
# Set to 0 for CPU-only mode if Ollama fails to initialize CUDA; -1 enables automatic GPU use.
OLLAMA_NUM_GPU=-1

# Optional override; qwen3:1.7b uses less memory than the default Mistral model.
OLLAMA_MODEL=mistral:7b-instruct-v0.3-q2_K

# Sessions expire after 8 hours or 30 minutes of inactivity.
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
ENVIRONMENT=development
# Production uses HTTPS and sets Secure cookies automatically.

# Local OCR configuration (keep machine-specific paths in untracked backend/.env)
APP_ENV=development
OCR_ENGINE=paddleocr_vl
OCR_MODEL_ID=PaddleOCR-VL-1.6
PADDLE_DEVICE=auto
PADDLE_VL_BACKEND=auto
PADDLE_VL_SERVER_URL=http://127.0.0.1:8111/
PADDLEOCR_VARIANT=mobile
PADDLEOCR_DEVICE=cpu
# Cleanup runs on scanned pages/images; original uploads remain unchanged.
PADDLEOCR_PREPROCESSING_ENABLED=true
OCR_PREPROCESSING_ENABLED=true
OCR_DENOISE_ENABLED=true
OCR_CONTRAST_ENABLED=true
OCR_DESKEW_ENABLED=true
OCR_THRESHOLD_ENABLED=true
OCR_THRESHOLD_METHOD=adaptive
PADDLEOCR_MOBILE_DET_MODEL_DIR=
PADDLEOCR_MOBILE_REC_MODEL_DIR=

# Optional local BGE-M3 override; defaults to the BAAI/bge-m3 model identifier.
EMBED_MODEL_PATH=
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://172.21.48.183:5173, http://172.21.48.183

# Generate a long random value for CIMS bearer authentication. Never commit the value.
CIMS_API_TOKEN=
