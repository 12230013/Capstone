MONGO_URI = 
CDR_API_BASE_URL=http://localhost:5000
CDR_API_TIMEOUT=15

RELATIONSHIP_API=http://localhost:3000
# Set to 0 for CPU-only mode if Ollama fails to initialize CUDA; -1 enables automatic GPU use.
OLLAMA_NUM_GPU=-1

# Optional override; qwen3:1.7b uses less memory than the default Mistral model.
OLLAMA_MODEL=mistral:7b-instruct-v0.3-q2_K

# Sessions expire after 8 hours or 30 minutes of inactivity.
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
ENVIRONMENT=development
# Production uses HTTPS and sets Secure cookies automatically.
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://172.21.48.183:5173, http://172.21.48.183
